# Copy to .env before running:  cp .env.example .env
# All values below are safe local defaults that match docker-compose.yml.

# App
PORT=3005

# Postgres (provided by docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cache_lab

# Redis (provided by docker-compose) — standalone, not cluster
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CLUSTER=false

# Short TTL so you can watch keys expire while learning
CACHE_DEFAULT_TTL=60
