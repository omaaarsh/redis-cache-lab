    "cache-manager": "^7.2.8",
    "ioredis": "^6.0.0",
    "keyv": "^5.6.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
